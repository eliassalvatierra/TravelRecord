<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja chica: $/km a la izquierda y total de km aceptados a la derecha. El contorno cambia de color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_overlay"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$/km —"
        android:textColor="@color/texto_claro"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#66FFFFFF" />

    <TextView
        android:id="@+id/tvTotalKm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0,0 km"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
